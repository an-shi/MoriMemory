# Runtime data directory. Defaults to ./data.
MORIMEMORY_DATA_DIR=./data

# Service access token. When empty, a high-entropy token is generated on the
# first start and persisted in data/config.json. MoriBot injects this value
# when it starts the embedded service.
MORIMEMORY_TOKEN=

# Optional overrides for an OpenAI-compatible embedding endpoint. Values set
# here take precedence over data/config.json and are never written to disk.
MORIMEMORY_EMBEDDING_API_KEY=
MORIMEMORY_EMBEDDING_BASE_URL=
MORIMEMORY_EMBEDDING_MODEL=

# Bind address/port for `morimemory serve`. Keep the loopback default unless a
# reverse proxy handles authentication and TLS.
MORIMEMORY_HOST=127.0.0.1
MORIMEMORY_PORT=6190
MORIMEMORY_LOG_LEVEL=INFO
