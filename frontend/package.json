{
  "name": "@moriai/memory-ui",
  "version": "0.1.0",
  "description": "Embeddable MoriMemory Explorer for MoriBot (Vue 3 + Vuetify 3)",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/memory-ui.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^3.13.0"
  },
  "dependencies": {
    "cytoscape": "^3.33.1"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "sass": "^1.108.2",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^3.2.4",
    "vue": "^3.5.45",
    "vue-tsc": "^2.2.12",
    "vuetify": "^3.13.7"
  }
}
